# Everything here can be set on the Settings page instead (npm start, then open the URL it prints).
# Values saved on that page win over this file. Never commit .env. Blank values use the default.

# ---- Connect your accounts ----
# xAI API key. From console.x.ai. Powers the Grok Voice calls.
X_API_KEY=
# Twilio Account SID. On your Twilio console home page. Starts with AC.
TWILIO_ACCOUNT_SID=
# Twilio Auth Token. Next to the Account SID in the Twilio console.
TWILIO_AUTH_TOKEN=
# Your Twilio phone number. Outbound calls come from this number, and inbound calls ring it.
TWILIO_PHONE_NUMBER=
# Public address of this server. The https address Twilio uses to reach this server, for example https://bot.example.com. See the README for running it on a server or through a tunnel.
PUBLIC_BASE=

# ---- Your business ----
# Company name
COMPANY_NAME=Acme Final Expense
# Bot's name
BOT_NAME=Sarah
# Licensed agent's name. Spoken on the call. Leave blank to say "your licensed agent", which fits a team or a call queue.
AGENT_NAME=
# Voice
VOICE=eve
# Carrier name. Said when the price is presented: "<carrier> came back with the best option for you."
CARRIER_NAME=Sample Carrier
# One line about the carrier. Finishes "They're ...", for example "rated A by AM Best and have paid claims since 1910".
CARRIER_BLURB=a sample carrier used for this demo

# ---- Calls and transfers ----
# Say it's a virtual assistant when the call starts. Recommended. Several states require telling people up front when they're talking to AI. If someone asks, the bot always answers honestly either way.
AI_DISCLOSURE=true
# Transfer finished calls to. The phone or call queue the bot hands callers to once the application is ready.
AGENT_TRANSFER_NUMBER=
# That number is
TRANSFER_MODE=person
# Longest call, in minutes. A hard cap on billed voice minutes for any one call.
MAX_CALL_MINUTES=20

# ---- Outbound calling ----
# Numbers the bot may call while testing. Demo mode only dials these. Put your own cell here.
DIAL_ALLOWLIST=
# I hold written consent for every number I call. Turns demo mode off so the bot can dial your leads. You are responsible for TCPA consent, Do Not Call scrubbing and calling hours. See COMPLIANCE.md.
CONSENT_CONFIRMED=false
# Your leads are people who
DIALER_SOURCE=tv_callback
# Calls at once
DIALER_LINES=1
# Tries per lead
DIALER_MAX_ATTEMPTS=3
# Minutes between tries
DIALER_GAP_MINUTES=120
# Most calls per day
DIALER_MAX_CALLS_PER_DAY=25
# Earliest hour to call (the lead's local time)
DIALER_WINDOW_START=9
# Stop calling at (the lead's local time)
DIALER_WINDOW_END=20

# ---- Inbound calls ----
# Let the bot answer calls to your Twilio number
INBOUND_ENABLED=false
# When the bot can't take a call, send it to. Used when the bot is busy, outside its hours, at its daily limit, or the server is down. Leave blank and callers hear a short "please call back" message.
INBOUND_FALLBACK_NUMBER=
# Bot answers from (hour, 0-23)
INBOUND_HOUR_START=9
# Bot answers until (hour, 1-24)
INBOUND_HOUR_END=19
# Time zone for those hours
INBOUND_TZ=America/Chicago
# Most calls the bot answers per day
INBOUND_MAX_PER_DAY=10
# Calls the bot answers at once
INBOUND_MAX_ACTIVE=1
# Look up callers in the CRM. Either way the bot asks the caller's name and never greets them by a name it looked up.
INBOUND_MATCH=any
# Keys to press when answering. Only if a call platform asks the receiver to "press 1 to accept". Example: w1 (wait half a second, press 1).
INBOUND_ACCEPT_DIGITS=

# ---- CRM ----
# CRM
CRM_PROVIDER=none
# CRM API address
DSB_BASE=
# CRM API token. Use a least-privilege token.
DSB_CRM_MCP=
# Status of the leads to call
DSB_QUEUE_STATUS=55
# Carrier id written on the lead
CRM_CARRIER_ID=
# Product id written on the lead
CRM_PRODUCT_ID=
# Put full bank details in the handoff note. Plain text: anyone who can open the lead can read it. Off writes only the bank name and the last 4 digits.
CRM_BANK_IN_NOTE=false

# ---- Script ----
# Opener: they requested information. Placeholders: {first} {bot} {company} {bot_intro}.
SCRIPT_OPENER_REQUESTED_INFO=
# Opener: returning a missed call. Placeholders: {first} {bot} {company} {bot_intro}.
SCRIPT_OPENER_TV_CALLBACK=
# Opener: someone calls in. Placeholders: {bot} {company} {bot_intro}. Never greet an inbound caller by a name you looked up.
SCRIPT_OPENER_INBOUND=
# Extra instructions for the bot. House rules, products, phrases to avoid. Added to the end of the bot's instructions.
SCRIPT_EXTRA=

# ---- Advanced ----
# Dashboard password. Required when this server is reachable from the internet. At least 12 characters. This browser stays signed in when you change it.
DASHBOARD_TOKEN=
# Voice model
VOICE_MODEL=grok-voice-3.0
# Practice calls at once. Each practice call spends real xAI credit.
PRACTICE_MAX_ACTIVE=2
# Rate table file. The shipped table is SAMPLE DATA, not real rates. Schema in the README.
RATE_TABLE=src/rates/sample-level-plan.json
# Media stream signature
TWILIO_STREAM_SIGNATURE=warn
# Encryption key for SSN and bank details. Created automatically on first start. Losing it makes saved details unreadable.
VAULT_KEY=

# ---- Server only (not on the Settings page) ----
# Bind address. Anything but loopback requires DASHBOARD_TOKEN.
HOST=127.0.0.1
# Port the server listens on.
PORT=4319
# Base URL the helper scripts use to reach the server (default http://HOST:PORT).
BASE_URL=
# Where the Settings page saves its values (default data/settings.json).
SETTINGS_FILE=
# Set to off to stop writing call event logs to data/calls.
CALL_LOG_DIR=
# Where the none CRM keeps leads.csv and outcomes.jsonl (default data/).
CRM_DATA_DIR=
# Set to off only while troubleshooting: skips the Twilio signature check on inbound webhooks. Never on the Settings page.
TWILIO_SIGNATURE_CHECK=on
# Optional JSON file with extra grader rubric items; see scripts/grade-call.mjs.
GRADER_RUBRIC_FILE=
