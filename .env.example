# Copy to .env and fill in. Never commit .env. Blank values are ignored.

# ---- Required to place calls ----
# xAI API key (Grok Voice 3.0 and the practice/grading models)
X_API_KEY=
# Twilio account credentials and the number calls come from (E.164, e.g. +15555550100)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# 32 random bytes, base64. Encrypts SSN and bank details in the vault. Losing it makes the vault unreadable.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VAULT_KEY=

# ---- Safety (demo mode is on by default) ----
# Comma-separated E.164 numbers the bot may dial while CONSENT_CONFIRMED is not true. Put YOUR phone here.
DIAL_ALLOWLIST=
# Set to true only when you hold prior express written consent for every number you dial and handle DNC and calling hours. See COMPLIANCE.md.
CONSENT_CONFIRMED=
# Hard cap on billed voice minutes per call (default 20)
MAX_CALL_MINUTES=
# Practice (roleplay) calls allowed at once; each spends real xAI credit (default 2)
PRACTICE_MAX_ACTIVE=

# ---- Your business ----
COMPANY_NAME=Acme Final Expense
# Name the bot gives itself
BOT_NAME=Sarah
# The licensed agent's name, spoken on the call. Default: "your licensed agent"
AGENT_NAME=
# Grok Voice voice name (default eve)
VOICE=
# Voice model (default grok-voice-3.0)
VOICE_MODEL=
# Number the live transfer rings (E.164)
AGENT_TRANSFER_NUMBER=
# Credibility line used when presenting the price: "<CARRIER_NAME> came back with the best option. They're <CARRIER_BLURB>, ..."
CARRIER_NAME=Sample Carrier
CARRIER_BLURB=a sample carrier used for this demo
# Rate table JSON (schema in README). Default ships SAMPLE DATA, not real rates.
RATE_TABLE=src/rates/sample-level-plan.json

# ---- Server and dashboard ----
# Bind address. Anything but loopback requires DASHBOARD_TOKEN.
HOST=127.0.0.1
PORT=4319
# When set, every dashboard and API route needs it (Bearer header, ?token=, or the cookie set after a ?token= visit)
DASHBOARD_TOKEN=
# Public https URL of your tunnel. If unset, the newest trycloudflare.com URL in data/tunnel.log is used.
PUBLIC_BASE=
# Base URL the helper scripts use to reach the server (default http://HOST:PORT)
BASE_URL=
# Set to off to stop writing call event logs to data/calls
CALL_LOG_DIR=
# Twilio webhook signatures are checked on /twiml/whisper and /twilio/amd. Set to off ONLY to troubleshoot
# a proxy that rewrites URLs; the per-process secret in those URLs still applies.
TWILIO_SIGNATURE_CHECK=
# The media-stream WebSocket signature only warns by default (it is not yet verified against live traffic).
# Set to enforce to reject streams whose signature does not verify.
TWILIO_STREAM_SIGNATURE=

# ---- CRM ----
# none (data/leads.csv in, data/outcomes.jsonl out) or dsb
CRM_PROVIDER=none
# Where the none adapter keeps leads.csv and outcomes.jsonl (default data/)
CRM_DATA_DIR=
# dsb adapter only: ids of the carrier and product written onto the lead
CRM_CARRIER_ID=
CRM_PRODUCT_ID=
# dsb adapter only: base URL and a least-privilege token for the CRM tool API
DSB_BASE=
DSB_CRM_MCP=
# dsb adapter only: status id of the queue the dialer works (default 55)
DSB_QUEUE_STATUS=

# ---- Dialer (callback queue) ----
DIALER_SOURCE=tv_callback
DIALER_LINES=1
DIALER_MAX_ATTEMPTS=3
DIALER_GAP_MINUTES=120
DIALER_MAX_CALLS_PER_DAY=25

# ---- Grading (optional) ----
# JSON file with extra grader rubric items; see scripts/grade-call.mjs
GRADER_RUBRIC_FILE=
